# ── Required ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/netcare_db
SECRET_KEY=your-secret-key-here-minimum-32-characters
OPENAI_API_KEY=sk-your-openai-key

# ── Email (Required) ──────────────────────────────────────────────────────────
SENDGRID_API_KEY=your-sendgrid-key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=Netta's Bounce Around Daycare

# ── App Config ────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=False
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_SECRET_KEY=your-refresh-secret-key-here-minimum-32-characters
ALGORITHM=HS256

# ── CORS ──────────────────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Optional: Redis ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Optional: Twilio SMS ──────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Optional: AWS S3 ──────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=nettas-daycare-files
AWS_REGION=us-east-1

# ── Optional: Daycare Info ────────────────────────────────────────────────────
DAYCARE_PHONE=
DAYCARE_EMAIL=
DAYCARE_ADDRESS=Chicago, IL
DCFS_LICENSE_NUMBER=
